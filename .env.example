# Supabase project URL and anon/publishable key (Project Settings -> API).
# Both are safe to expose to the browser; access is enforced by Row Level Security.
# Never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a long random string used to salt the hashed IP stored with contact messages.
CONTACT_IP_SALT=

# Chatbot: free-tier Google AI Studio key (https://aistudio.google.com/apikey). Server-only.
# Without it the bot still answers from the FAQ and site data, just less fluently.
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-latest.
GEMINI_MODEL=
